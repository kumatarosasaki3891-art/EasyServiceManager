<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Services\Localization.fs" />
    <Compile Include="Services\AppSettings.fs" />
    <Compile Include="Models\ServiceEntry.fs" />
    <Compile Include="Models\SecurityFinding.fs" />
    <Compile Include="Services\ServiceDiscovery.fs" />
    <Compile Include="Services\SecurityAudit.fs" />
    <Compile Include="Services\ReportExporter.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
