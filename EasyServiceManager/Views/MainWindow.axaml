<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyServiceManager.ViewModels"
        xmlns:model="using:EasyServiceManager.Models"
        xmlns:controls="using:EasyServiceManager.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="750"
        x:Class="EasyServiceManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Title="{Binding AppTitle}"
        Width="1320" Height="750" MinWidth="1050" MinHeight="600"
        Background="#F4F6F8">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#18212B" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="240,*,415">
        <Border Grid.Column="0" Background="#172331" Padding="18,22">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                    <Border Width="44" Height="44" CornerRadius="10" ClipToBounds="True"
                            BorderBrush="#374C61" BorderThickness="1" VerticalAlignment="Center">
                        <Image Source="/Assets/icon.jpg" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" Foreground="White" FontSize="17" FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AppSubtitle}" Foreground="#AAB8C6" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding CategoryHeading}" Foreground="#91A2B3" FontSize="11"
                           FontWeight="Bold" Margin="4,28,0,10" />
                <ListBox Grid.Row="2" ItemsSource="{Binding CategoryOptions}"
                         SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryOption">
                            <Border Padding="10,9" CornerRadius="7">
                                <Grid ColumnDefinitions="28,*">
                                    <TextBlock Text="{Binding Icon}" Foreground="#C5D1DC" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#E5EBF0"
                                               FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Spacing="8" Margin="0,18,0,0">
                    <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"
                            HorizontalContentAlignment="Center"
                            Background="#314354" Foreground="White" Content="{Binding RefreshLabel}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#91A2B3" FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,24,18,20" RowDefinitions="Auto,Auto,Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding ServiceListLabel}" FontSize="24" FontWeight="Bold" />
                <Border Background="#E2E9EF" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ServiceCountBadgeText}" FontSize="12" Foreground="#536678" />
                </Border>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#687887" FontSize="12"
                       Margin="0,6,0,16" />
            <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding SearchPlaceholder}" Padding="12,10" CornerRadius="8"
                     Background="White" BorderBrush="#DDE4EA" Margin="0,0,0,12" />
            <Grid Grid.Row="3" RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="model:ServiceEntry">
                            <Border Background="{Binding RowBackground}" BorderBrush="{Binding RowBorderBrush}" BorderThickness="1"
                                    CornerRadius="9" Padding="0" MinHeight="72">
                                <Grid ColumnDefinitions="5,*,Auto">
                                    <Border Background="{Binding AccentBarColor}" CornerRadius="9,0,0,9" />
                                    <StackPanel Grid.Column="1" Margin="14,11" Spacing="5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding StatusIcon}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="★" Foreground="#D89B22" IsVisible="{Binding IsFavorite}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#788693" FontSize="11"
                                                   IsVisible="{Binding ShowSubtitle}" />
                                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                                                CornerRadius="5" Padding="6,2" HorizontalAlignment="Left"
                                                IsVisible="{Binding IsDiff}">
                                            <TextBlock Text="{Binding DiffNoteLabel}" Foreground="#92400E"
                                                       FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,10,14,10" Spacing="5"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CategoryLabel}" Foreground="#647585" FontSize="10"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ListPortLabel}" Foreground="#287A68" FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#B42318" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </Grid>

        <Border Grid.Column="2" Background="White" BorderBrush="#E3E8ED" BorderThickness="1,0,0,0"
                Padding="20,16,20,20">
            <Grid RowDefinitions="Auto,1.45*,*,Auto" RowSpacing="10">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LanguageLabel}" Foreground="#687887" FontSize="11"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}"
                              Width="124">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Command="{Binding OpenInfoDialogCommand}"
                            ToolTip.Tip="{Binding InfoDialogTitle}"
                            Width="34" Height="32" Padding="0" VerticalAlignment="Center"
                            Background="#E2E8F0" Foreground="#172331" CornerRadius="7"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Grid Width="26" Height="22">
                            <TextBlock Text="ℹ️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Fill="#2563EB"
                                     IsVisible="{Binding IsAppOutdated}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                     ToolTip.Tip="{Binding AppUpdateAvailableText}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1" Background="#F5F7F9" BorderBrush="#DCE4EA" BorderThickness="1"
                        CornerRadius="12" Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding SecurityTitle}" FontSize="17" FontWeight="Bold"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding OpenDiagnosticsModalCommand}"
                                        Content="{Binding ExpandDiagnosticsButtonLabel}"
                                        Background="#E5F2EE" Foreground="#1B6655"
                                        FontSize="11" FontWeight="SemiBold" Padding="9,4" CornerRadius="6"
                                        VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding SecuritySummary}" Foreground="#71808E"
                                       FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DefinitionDateText}" Foreground="#71808E"
                                       FontSize="9" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,8">
                            <controls:SecurityScoreCard />

                            <Border Background="#FEFCE8" BorderBrush="#FACC15" BorderThickness="1"
                                    CornerRadius="8" Padding="10" MaxHeight="100"
                                    IsVisible="{Binding HasScanDiffs}">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Text="{Binding ScanDiffTitle}" FontWeight="Bold" FontSize="11"
                                               Foreground="#854D0E" Margin="0,0,0,4" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ScanDiffMessages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding .}" FontSize="10" Foreground="#713F12"
                                                               TextWrapping="Wrap" Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding NoDiffMessageLabel}" FontSize="11" Foreground="#516273"
                                       Margin="2,0,0,0" IsVisible="{Binding ShowNoDiffMessage}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="2,2,0,6">
                            <TextBlock Text="{Binding DiagnosticItemsLabel}" FontSize="12"
                                       FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="#E2E9EF" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FindingsCountBadgeText}" FontSize="10" Foreground="#536678" />
                            </Border>
                        </StackPanel>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <controls:SecurityFindingsList IsCompact="True" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#E3E8ED" BorderThickness="1"
                        CornerRadius="10" Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel IsVisible="{Binding HasNotAddingCustom}" Spacing="12">
                                <TextBlock Text="{Binding DetailTitle}" FontSize="17" FontWeight="Bold" />
                                <Border Height="1" Background="#E8EDF1" />
                                <StackPanel IsVisible="{Binding HasSelectedService}">
                                    <TextBlock Text="{Binding ServiceNameLabel}" Foreground="#778695" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedService.Name}" FontSize="18" FontWeight="Bold"
                                               Margin="0,3,0,6" TextWrapping="Wrap" />
                                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" Margin="0,0,0,10"
                                            IsVisible="{Binding SelectedService.IsDiff}">
                                        <TextBlock Text="{Binding SelectedService.DiffNoteLabel}" Foreground="#92400E"
                                                   FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayNameLabel}" Foreground="#778695" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedService.DisplayName}" FontSize="12"
                                               Margin="0,3,0,10" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ServiceCategoryLabel}" Foreground="#778695" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedService.CategoryLabel}" FontSize="12" Margin="0,3,0,10" />
                                    <TextBlock Text="{Binding StateLabel}" Foreground="#778695" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedService.StatusLabel}" FontSize="12" Margin="0,3,0,10" />
                                    <TextBlock Text="{Binding PortLabel}" Foreground="#778695" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedService.PortLabel}" FontSize="12" Margin="0,3,0,4"
                                               TextWrapping="Wrap" />
                                    <Border IsVisible="{Binding SelectedService.HasSharedPorts}"
                                            Background="#FFF6DD" BorderBrush="#EBD392" BorderThickness="1"
                                            CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectedService.SharedProcessNote}"
                                                   Foreground="#8A6413" FontSize="10" TextWrapping="Wrap" />
                                    </Border>
                                    <StackPanel IsVisible="{Binding SelectedService.HasExposureInfo}" Margin="0,0,0,10" Spacing="3">
                                        <TextBlock Text="{Binding ExposureSectionLabel}" Foreground="#778695" FontSize="10" />
                                        <Border Background="{Binding SelectedService.ExposureBadgeBg}" CornerRadius="5"
                                                Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding SelectedService.ExposureLabel}"
                                                       Foreground="{Binding SelectedService.ExposureBadgeFg}"
                                                       FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ExecutableLabel}" Foreground="#778695" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedService.ExecutableLabel}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,10" />
                                    <TextBlock Text="{Binding UrlLabel}" Foreground="#778695" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedService.UrlLabel}" FontSize="11"
                                               TextWrapping="Wrap" Foreground="#287A68" Margin="0,3,0,10" />
                                    <Button Command="{Binding ToggleFavoriteCommand}" Content="{Binding FavoriteButtonText}"
                                            HorizontalContentAlignment="Center" Background="#FFF6DD"
                                            Foreground="#8A6413" Margin="0,5,0,0" />
                                    <Button Command="{Binding OpenBrowserCommand}" Content="{Binding BrowserButtonLabel}"
                                            IsEnabled="{Binding CanOpenSelectedService}" HorizontalContentAlignment="Center"
                                            Background="#217A66" Foreground="White" Margin="0,7,0,0" />
                                    <Border IsVisible="{Binding IsContainerServiceSelected}"
                                            Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                            CornerRadius="7" Padding="10,8" Margin="0,7,0,0">
                                        <TextBlock Text="{Binding ContainerIntegrationGuideLabel}"
                                                   Foreground="#1E40AF" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                                <Border IsVisible="{Binding HasNoSelectedService}" Background="#F0F3F5"
                                        CornerRadius="8" Padding="12">
                                    <TextBlock Text="{Binding NoSelectedServiceText}" Foreground="#7C8995"
                                               FontSize="11" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" IsVisible="{Binding IsAddingCustom}" Spacing="9">
                                <TextBlock Text="{Binding CustomFormTitle}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{Binding CustomFormDescription}" Foreground="#71808E"
                                           FontSize="11" TextWrapping="Wrap" />

                                <TextBlock Text="{Binding PresetHeadingLabel}" Foreground="#596A79" FontSize="10" />
                                <ItemsControl ItemsSource="{Binding CustomPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CustomPreset">
                                            <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ApplyPresetCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding Label}"
                                                    FontSize="10" Padding="6,3" Margin="0,0,4,4"
                                                    Background="#EAEFF4" Foreground="#314454" CornerRadius="5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding CustomNameLabel}" Foreground="#596A79" FontSize="10" />
                                <TextBox Text="{Binding CustomName}" PlaceholderText="{Binding CustomNamePlaceholder}" />
                                <TextBlock Text="{Binding CustomDisplayNameLabel}" Foreground="#596A79" FontSize="10" />
                                <TextBox Text="{Binding CustomDisplayName}"
                                         PlaceholderText="{Binding CustomDisplayNamePlaceholder}" />
                                <TextBlock Text="{Binding CustomCategoryLabel}" Foreground="#596A79" FontSize="10" />
                                <ComboBox ItemsSource="{Binding CustomCategories}" SelectedValue="{Binding CustomCategory}"
                                          SelectedValueBinding="{Binding Name}"
                                          PlaceholderText="{Binding CustomCategoryPlaceholder}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding CustomUrlLabel}" Foreground="#596A79" FontSize="10" />
                                <TextBox Text="{Binding CustomUrl}" PlaceholderText="{Binding CustomUrlPlaceholder}" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" FontSize="11"
                                           TextWrapping="Wrap" />
                                <Button Command="{Binding AddCustomCommand}" Content="{Binding AddCustomLabel}"
                                        HorizontalContentAlignment="Center" Background="#217A66" Foreground="White" />
                                <Button Command="{Binding CancelCustomCommand}" Content="{Binding CancelLabel}"
                                        HorizontalContentAlignment="Center" Background="#EEF1F4" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Command="{Binding ToggleCustomFormCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#EEF3F6" Foreground="#314454" Padding="6,8">
                        <TextBlock Text="{Binding ToggleCustomFormLabel}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="1" Command="{Binding OpenExportModalCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#E5F2EE" Foreground="#1B6655" Padding="6,8">
                        <TextBlock Text="{Binding ExportReportButtonLabel}" FontSize="11" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- レポート出力 & QRコード転送モーダル -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding IsExportModalOpen}"
              Background="#99000000" ZIndex="100">
            <Border Background="White" BorderBrush="#D0DAE3" BorderThickness="1"
                    CornerRadius="16" Padding="24,20" Width="540" MaxWidth="580"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 32 0 #40000000">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ExportModalTitle}" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding CloseExportModalCommand}" Content="✕"
                                Background="Transparent" Foreground="#5B6B7A" FontSize="16"
                                Padding="8,4" />
                    </Grid>
                    <TextBlock Text="{Binding ExportModalDescription}" Foreground="#5B6B7A"
                               FontSize="12" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Command="{Binding SaveMarkdownCommand}"
                                Content="{Binding SaveMarkdownButtonLabel}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#EEF3F6" Foreground="#18212B" FontSize="12" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Command="{Binding SaveHtmlCommand}"
                                Content="{Binding SaveHtmlButtonLabel}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#EEF3F6" Foreground="#18212B" FontSize="12" FontWeight="SemiBold" />
                        <Button Grid.Column="2" Command="{Binding StartQrTransferCommand}"
                                Content="{Binding StartQrTransferButtonLabel}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#217A66" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Grid>

                    <TextBlock IsVisible="{Binding HasExportMessage}" Text="{Binding ExportMessage}"
                               Foreground="{Binding ExportMessageColor}" FontSize="12"
                               TextWrapping="Wrap" />

                    <!-- QR転送パネル -->
                    <Border IsVisible="{Binding IsQrSectionVisible}" Background="#F8FAFC"
                            BorderBrush="#DCE4EA" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding QrGuideLabel}" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="{Binding QrSubGuideLabel}" Foreground="#5B6B7A"
                                       FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="440" />

                            <Border IsVisible="{Binding IsQrActive}" Background="White"
                                    BorderBrush="#B2DFDB" BorderThickness="2" CornerRadius="12"
                                    Padding="10" Width="224" Height="224" HorizontalAlignment="Center">
                                <Image Source="{Binding QrImage}" Width="200" Height="200"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="None" />
                            </Border>

                            <Border IsVisible="{Binding IsQrInvalidated}" Background="#F1F5F9"
                                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12"
                                    Padding="16" Width="224" Height="160" HorizontalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                    <TextBlock Text="🚫" FontSize="30" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding QrInvalidatedLabel}" FontSize="13" FontWeight="Bold"
                                               Foreground="#64748B" HorizontalAlignment="Center" />
                                    <Button Command="{Binding StartQrTransferCommand}"
                                            Content="{Binding RegenerateQrButtonLabel}"
                                            Background="#217A66" Foreground="White" FontSize="11"
                                            HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                        IsVisible="{Binding IsQrActive}">
                                <TextBlock Text="{Binding QrUrlText}" Foreground="#1B6655" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Command="{Binding SwitchQrIpCommand}"
                                        Content="{Binding SwitchIpButtonText}"
                                        IsVisible="{Binding HasMultipleIps}"
                                        Background="#E5F2EE" Foreground="#1B6655" FontSize="11"
                                        Padding="8,4" />
                            </StackPanel>

                            <Border Background="{Binding QrStatusBg}" CornerRadius="8" Padding="12,8"
                                    HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding QrStatusText}" Foreground="{Binding QrStatusFg}"
                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding QrSecurityNoteLabel}" Foreground="#64748B"
                                       FontSize="10" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="450" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding CloseExportModalCommand}"
                            Content="{Binding CloseModalButtonLabel}"
                            HorizontalAlignment="Right" Background="#EEF1F4" Foreground="#314454"
                            Padding="18,8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- アプリ情報モーダル -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding IsInfoDialogOpen}"
              Background="#99000000" ZIndex="101">
            <Border Background="White" BorderBrush="#D0DAE3" BorderThickness="1"
                    CornerRadius="16" Padding="24,20" Width="480" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 32 0 #40000000">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center">
                            <Image Source="/Assets/icon.jpg" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppTitle}" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="{Binding InfoDialogTitle}" FontSize="11" Foreground="#687887" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseInfoDialogCommand}" Content="✕"
                                Background="Transparent" Foreground="#5B6B7A" FontSize="16" Padding="8,4" />
                    </Grid>

                    <Border Height="1" Background="#E3E8ED" />

                    <Border Background="#F5F7F9" BorderBrush="#DCE4EA" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding CurrentVersionHeader}" FontSize="11" Foreground="#687887" />
                                    <TextBlock Text="{Binding CurrentAppVersionText}" FontSize="15" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding LatestVersionHeader}" FontSize="11" Foreground="#687887" />
                                    <TextBlock Text="{Binding LatestAppVersionText}" FontSize="15" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsAppOutdated}">
                                <TextBlock Grid.Column="0" Text="{Binding AppUpdateAvailableText}"
                                           FontSize="12" Foreground="#2563EB" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Command="{Binding OpenLatestVersionCommand}"
                                        Content="{Binding ViewLatestVersionLabel}"
                                        IsVisible="{Binding HasStoreUpdateLink}"
                                        Background="#2563EB" Foreground="White"
                                        FontSize="11" Padding="10,5" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#F5F7F9" BorderBrush="#DCE4EA" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DefinitionDateText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MasterDataUpdateStatus}" IsVisible="{Binding HasMasterDataUpdateStatus}"
                                           FontSize="11" Foreground="#5B6B7A" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding UpdateMasterDataCommand}"
                                    Content="{Binding UpdateMasterDataButtonLabel}"
                                    IsEnabled="{Binding CanUpdateMasterData}"
                                    Background="#E5F2EE" Foreground="#1B6655" FontWeight="SemiBold"
                                    FontSize="12" Padding="10,6" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Spacing="8">
                        <Button Command="{Binding OpenReleasesCommand}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Background="#EEF3F6" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="📦" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ReleasesButtonLabel}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ReleasesUrlText}" FontSize="11" Foreground="#687887" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="13" Foreground="#687887" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Command="{Binding OpenWebsiteCommand}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Background="#EEF3F6" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="🌐" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WebsiteButtonLabel}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WebsiteUrlText}" FontSize="11" Foreground="#687887" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="13" Foreground="#687887" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Command="{Binding OpenInstagramCommand}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Background="#EEF3F6" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="📷" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InstagramButtonLabel}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InstagramUrlText}" FontSize="11" Foreground="#687887" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="13" Foreground="#687887" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding PrivacyNoticeText}" FontSize="11" Foreground="#687887" TextWrapping="Wrap" />

                    <Button Command="{Binding CloseInfoDialogCommand}"
                            Content="{Binding CloseModalButtonLabel}"
                            HorizontalAlignment="Right" Background="#EEF1F4" Foreground="#314454"
                            Padding="18,8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 診断結果拡大モーダル（じっくり読む用・共用部品で所見全文を表示） -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding IsDiagnosticsModalOpen}"
              Background="#99000000" ZIndex="102">
            <Border Background="White" BorderBrush="#D0DAE3" BorderThickness="1"
                    CornerRadius="16" Padding="24,20" Width="820" MaxWidth="900" MaxHeight="660"
                    Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 32 0 #40000000">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                    <!-- ヘッダー -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SecurityTitle}" FontSize="20" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Border Background="#EEF3F6" BorderBrush="#DCE4EA" BorderThickness="1"
                                        CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DefinitionDateText}" FontSize="10"
                                               Foreground="#5B6B7A" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SecuritySummary}" Foreground="#687887"
                                       FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseDiagnosticsModalCommand}" Content="✕"
                                Background="Transparent" Foreground="#5B6B7A" FontSize="16" Padding="8,4"
                                VerticalAlignment="Top" />
                    </Grid>

                    <!-- 上段：スコア・警告件数・内訳・差分 -->
                    <StackPanel Grid.Row="1" Spacing="10">
                        <controls:SecurityScoreCard />

                        <WrapPanel Orientation="Horizontal">
                            <Border Background="#DCFCE7" BorderBrush="#A7F3D0" BorderThickness="1"
                                    CornerRadius="6" Padding="9,4" Margin="0,0,8,4">
                                <TextBlock Text="{Binding GoodFindingsCountLabel}" Foreground="#166534"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                    CornerRadius="6" Padding="9,4" Margin="0,0,8,4">
                                <TextBlock Text="{Binding WarningFindingsCountLabel}" Foreground="#92400E"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1"
                                    CornerRadius="6" Padding="9,4" Margin="0,0,8,4"
                                    IsVisible="{Binding HasInfoFindings}">
                                <TextBlock Text="{Binding InfoFindingsCountLabel}" Foreground="#075985"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                    CornerRadius="6" Padding="9,4" Margin="0,0,8,4"
                                    IsVisible="{Binding HasUnknownFindings}">
                                <TextBlock Text="{Binding UnknownFindingsCountLabel}" Foreground="#475569"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </WrapPanel>

                        <Border Background="#FEFCE8" BorderBrush="#FACC15" BorderThickness="1"
                                CornerRadius="8" Padding="10" MaxHeight="110"
                                IsVisible="{Binding HasScanDiffs}">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="{Binding ScanDiffTitle}" FontWeight="Bold" FontSize="11"
                                           Foreground="#854D0E" Margin="0,0,0,4" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ScanDiffMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding .}" FontSize="11" Foreground="#713F12"
                                                           TextWrapping="Wrap" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 下段：所見全文一覧（パネルと共用コントロール） -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DiagnosticItemsLabel}" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Border Background="#E2E9EF" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FindingsCountBadgeText}" FontSize="11" Foreground="#536678" />
                            </Border>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <controls:SecurityFindingsList IsCompact="False" />
                        </ScrollViewer>
                    </Grid>

                    <!-- フッター -->
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Command="{Binding OpenExportFromDiagnosticsCommand}"
                                Content="{Binding ExportReportButtonLabel}"
                                Background="#E5F2EE" Foreground="#1B6655" FontWeight="SemiBold"
                                Padding="14,8" />
                        <Button Grid.Column="2" Command="{Binding CloseDiagnosticsModalCommand}"
                                Content="{Binding CloseModalButtonLabel}"
                                Background="#EEF1F4" Foreground="#314454" Padding="18,8" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
